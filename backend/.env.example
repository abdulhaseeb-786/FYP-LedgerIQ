# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME=LedgerIQ
API_V1_PREFIX=/api/v1

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_random_64_character_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://ledgeriq_user:ledgeriq_secret_password@localhost:5432/ledgeriq_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Project Limits & Retention (Quotas)
DEFAULT_MAX_PROJECTS_PER_USER=5
DEFAULT_PROJECT_RETENTION_DAYS=90
DEFAULT_USER_CREDITS=100
MAX_UPLOAD_SIZE_MB=25

# Storage Provider: "local" or "s3"
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
